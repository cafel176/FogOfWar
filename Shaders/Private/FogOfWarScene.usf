// Copyright Winyunq, 2025. All Rights Reserved.
//
// 场景战争迷雾（世界空间视野场版）。三趟：
//   VisionFieldSplatCS   —— 每条视野源只在自己的场 AABB 内派发线程，用 InterlockedMax 把定标覆盖率
//                           写进 R32_UINT。重叠圆盘因此不再各跑一遍像素着色、也不再有混合状态：
//                           overdraw 被彻底消掉（旧实现的成本是 Σ 圆盘屏幕面积 × 重叠层数）。
//   VisionFieldPackVS/PS —— 把整数覆盖率与"历史已探索"打包成一张 PF_R8G8：
//                           R = 当前帧视野覆盖率，G = 已探索（一旦置位不回退）。
//   CompositeVS/PS       —— 屏幕像素反投影到世界平面 → 采样 R8G8 → 可见 / 已探索但不可见 / 未探索三态。
//
// 覆盖率为什么算在世界空间而不是屏幕空间：
//   ① 每条源的 AABB 是纯算术（世界圆 → 场纹素矩形），不含任何相机投影，因此不存在"源落在相机后方 /
//      掠射角导致屏幕 AABB 退化"这类必须在 CPU 端特判的边界情形；
//   ② 结果与相机无关：多视口（分屏 / SceneCapture）共享同一份场，splat 一帧只做一次；
//   ③ 与"历史已探索"所在的逐格网格同世界矩形、同 UV，G 通道不需要任何额外换算。
//
// 复杂度：
//   旧（后处理材质）：O(屏幕像素数 × 源数) —— 1080p × 500 源 ≈ 1e9 次内层迭代。
//   旧（屏幕空间几何散射）：O(Σ 圆盘屏幕面积 × 重叠层数)，重叠区被反复着色。
//   新：O(Σ 圆盘场纹素面积 + 场纹素数 + 屏幕像素数)，每个纹素只做一次整数原子比较。
//
// 世界 → 场纹素：纹素 (x, y) 的采样中心 = FieldWorldMin + (xy + 0.5) * FieldTexelSizeCm
// 场 → 屏幕（合成趟）：逐像素用视口 UV + 场景深度反投影回真实世界位置，再换算成场 UV。
//   （深度不可用时退回 Z = FogPlaneZ 平面投影，见 PixelWorldXYFromDepth。）
//
// ⚠ 反投影必须在像素阶段逐像素做，不能放到顶点阶段靠插值传递。
//   顶点着色器输出的 Position.w = 1，光栅器据此判定“无透视”，于是对顶点携带的附加量做屏幕空间
//   线性插值；而“Z = FogPlaneZ 平面上的世界 XY”作为屏幕坐标的函数是有理函数（含透视除法），
//   只有三角形的三个角上是对的，中间会被拉偏，且偏移量随俯仰角 / 距离变化 —— 症状就是雾随相机
//   转动而相对场景滑移、形状被拉伸。视口 UV 与屏幕像素是线性关系，是顶点阶段唯一能安全插值的量。

#include "/Engine/Public/Platform.ush"

// SceneTexturesStruct：引擎约定名的场景纹理 uniform buffer（deferred 路径下才有），
// 合成趟从中读场景深度做像素反投影。C++ 侧以
// SHADER_PARAMETER_RDG_UNIFORM_BUFFER(FSceneTextureUniformParameters, SceneTexturesStruct) 声明。
#include "/Engine/Private/SceneTexturesCommon.ush"

// 一个线程组负责一条视野源；组内线程按 8×8 的步长扫过该源的 AABB。
#define VISION_FIELD_GROUP_SIZE 8

// ---------------------------------------------------------------------------------------------
// 场几何与共享参数
// ---------------------------------------------------------------------------------------------

// 场纹素 (0, 0) 左上角对应的世界 XY（cm）。
float2 FieldWorldMin;

// 场在世界空间中的尺寸（cm）：FieldTexelCount * FieldTexelSizeCm。
float2 FieldWorldExtent;

// 单个场纹素的世界边长（cm）。注意它不是"格尺寸 / 每格纹素数"的简写形式 ——
// 场分辨率在 CPU 端会被上限 clamp，因此唯一自洽的定义是 世界尺寸 / 纹素数。
float FieldTexelSizeCm;

// 覆盖率定标分母（255）：场纹理里的整数覆盖率 = round(Coverage * VisionCoverageScale)。
float VisionCoverageScale;

// 视野圆边缘软化宽度（cm）；0 = 硬边。
float SceneFogEdgeWidth;

// ---------------------------------------------------------------------------------------------
// 趟 1：覆盖率的原子散射
// ---------------------------------------------------------------------------------------------

// 每条视野源一个 float4：(WorldX, WorldY, Radius, Reserved)。
StructuredBuffer<float4> VisionSources;

// 与 VisionSources 同索引的扇形参数：(dirX, dirY, cosHalfAngle, Reserved)。
//   cosHalfAngle >= 1 → 该源是全向的（CPU 侧对张角 >= 360 的源写 2.0），扇形判定整体跳过；
//   否则只有"像素相对源中心的方向"与 (dirX, dirY) 的夹角 <= halfAngle 时才揭雾。
// 朝向来自单位自身的朝向，张角来自索敌配置的 Common::TraceAngle —— 与 VisionSources 里
// 的半径同源，所以揭雾扇形与索敌扇形天然一致。
StructuredBuffer<float4> VisionSourceDirs;

// 每条视野源在场空间里的保守 AABB：xy = 最小纹素（含），zw = 最大纹素（不含）。
// CPU 端由"圆心 ± 半径"直接算成纹素矩形并 clamp 到场范围，不含任何投影。
StructuredBuffer<uint4> VisionSourceAabbs;

// 覆盖率场（定标 0..255 的整数）。本趟输出，趟 2 用作输入。
RWTexture2D<uint> VisionCoverage;

[numthreads(VISION_FIELD_GROUP_SIZE, VISION_FIELD_GROUP_SIZE, 1)]
void VisionFieldSplatCS(uint3 GroupID : SV_GroupID, uint3 GroupThreadID : SV_GroupThreadID)
{
	// dispatch 的 Z 维就是源数：一个线程组 = 一条视野源，组内线程合计覆盖这条源的 AABB。
	// 这就是"每源 AABB dispatch"的落地方式 —— 不派发任何与这条源无关的纹素，也就不存在空转。
	const uint SourceIndex = GroupID.z;
	const float4 Source = VisionSources[SourceIndex];
	const uint4 Aabb = VisionSourceAabbs[SourceIndex];

	const uint2 AabbMin = Aabb.xy;
	const uint2 AabbMax = Aabb.zw;

	const float Radius = max(Source.z, 0.0);
	const float2 Center = Source.xy;
	const float EdgeWidth = max(SceneFogEdgeWidth, 0.0);
	const float SoftenStart = max(Radius - EdgeWidth, 0.0);

	for (uint Y = AabbMin.y + GroupThreadID.y; Y < AabbMax.y; Y += VISION_FIELD_GROUP_SIZE)
	{
		for (uint X = AabbMin.x + GroupThreadID.x; X < AabbMax.x; X += VISION_FIELD_GROUP_SIZE)
		{
			const float2 TexelCenter = FieldWorldMin + (float2(X, Y) + 0.5) * FieldTexelSizeCm;
			const float2 ToTexel = TexelCenter - Center;
			const float Distance = length(ToTexel);

			// 扇形裁剪：Dir.z 是 cos(半角)。>= 1 表示全向（CPU 对张角 >= 360 的源写 2.0），
			// 整段跳过 —— 圆形揭雾的老行为一字不改。
			// 判定用"像素相对源中心的方向"：落在扇形之外就完全不揭雾（硬边；半径方向仍由上面的
			// SceneFogEdgeWidth 软化）。注意要先避开 Distance ≈ 0，否则归一化会出 NaN。
			const float4 Dir = VisionSourceDirs[SourceIndex];
			if (Dir.z < 1.0 && Distance > 1e-4)
			{
				if (dot(ToTexel / Distance, Dir.xy) < Dir.z)
				{
					continue;
				}
			}

			// 圆内 1、圆外 0，边缘按 SceneFogEdgeWidth 在半径内侧软化。
			// 软化宽度为 0 时走硬边分支：smoothstep 在 min == max 上是未定义行为，不能靠它退化。
			float Coverage;
			if (EdgeWidth > 0.0)
			{
				Coverage = 1.0 - smoothstep(SoftenStart, Radius, Distance);
			}
			else
			{
				Coverage = Distance < Radius ? 1.0 : 0.0;
			}

			if (Coverage <= 0.0)
			{
				continue;
			}

			// 原子取最大 —— 重叠圆盘取并集的全部实现。
			// 重叠纹素会被多条源的线程反复触及，但每次只是一次整数原子比较：既没有像素着色器，
			// 也没有混合单元，所以"重叠"在这里只剩原子竞争的成本，不再有旧实现那种逐层着色。
			InterlockedMax(VisionCoverage[uint2(X, Y)], (uint)(Coverage * VisionCoverageScale + 0.5));
		}
	}
}

// ---------------------------------------------------------------------------------------------
// 趟 2：覆盖率 + 已探索 → PF_R8G8
// ---------------------------------------------------------------------------------------------

// 趟 1 的整数覆盖率（SRV 视图）。
Texture2D<uint> VisionCoverageTexture;

// 历史已探索层：LSB-first 位流（word i 的 bit b = 全局 bit i*32+b），与 CPU 侧权威探索层的位图
// 同布局，因此从位图拷进来只需一次 memcpy，不需要在 CPU 端展开成逐格字节。
// 它来自外部（MassBattleMap）而不是本插件自己攒的历史，因此本插件仍然不持有任何跨帧状态；
// 没有提供者时给一个 0 元素的兜底，G 通道恒为 0，合成退化为阶段一的二态雾。
StructuredBuffer<uint> VisionExploredBits;

// 已探索位图的分辨率（格数）。
int2 VisionExploredExtent;

// 场分辨率（纹素数）：场与已探索层共用同一个世界矩形，UV 直接换算。
int2 FieldTexelCount;

/** 读一位已探索（坐标按边界 clamp，越界按最近的一格算）。 */
float ReadExploredBit(int2 Coord)
{
	const int2 Clamped = clamp(Coord, int2(0, 0), VisionExploredExtent - 1);
	const int Index = Clamped.y * VisionExploredExtent.x + Clamped.x;
	return (float)((VisionExploredBits[Index >> 5] >> (Index & 31)) & 1u);
}

/**
 * 已探索层的双线性采样。
 *
 * 不能用纹理采样器（数据是位流而非纹理），但插值必须自己做：已探索层是逐格二值的，而场通常比它细
 * （一个格对应好几圈纹素）。点采样会让"已探索边界"在屏幕上呈现为整格的方块，双线性之后才是一条
 * 跨格的过渡带 —— 这正是灰雾该有的样子。
 */
float SampleExploredBilinear(float2 FieldUV)
{
	// 场 UV → 已探索格坐标：UV * Extent 是格边界上的连续坐标，减 0.5 把它挪到格中心。
	const float2 GridCoord = FieldUV * (float2)VisionExploredExtent - 0.5;
	const int2 Base = (int2)floor(GridCoord);
	const float2 Frac = saturate(GridCoord - (float2)Base);

	const float2 Bottom = lerp(ReadExploredBit(Base + int2(0, 0)), ReadExploredBit(Base + int2(1, 0)), Frac.x);
	const float2 Top = lerp(ReadExploredBit(Base + int2(0, 1)), ReadExploredBit(Base + int2(1, 1)), Frac.x);
	return lerp(Bottom.x, Top.x, Frac.y);
}

float2 VisionFieldPackPS(float4 SvPosition : SV_Position) : SV_Target0
{
	// 覆盖率用 Load 而不是采样：整数场与输出纹素一一对应，点采样就是它唯一正确的读法。
	const uint2 Texel = uint2(SvPosition.xy);
	const float Coverage = (float)VisionCoverageTexture.Load(int3(Texel, 0)) * (1.0 / VisionCoverageScale);

	const float2 FieldUV = (float2(Texel) + 0.5) / (float2)FieldTexelCount;
	const float Explored = SampleExploredBilinear(FieldUV);

	return float2(Coverage, Explored);
}

// ---------------------------------------------------------------------------------------------
// 趟 3：合成
// ---------------------------------------------------------------------------------------------

// xy = 缩放，zw = 偏移：把 [0,1] 的视口 UV 映射到对应纹理的 UV
float4 SceneColorUVScaleBias;

// 世界 → 裁剪空间的逆矩阵：把全屏三角形的角反投影回世界平面。
float4x4 InvViewProjection;

// 视野圆（以及视野场）所在的世界 Z 平面（cm）
float FogPlaneZ;

// 当前帧覆盖率与历史已探索打包成的 R8G8（R = 当前覆盖率，G = 已探索）
Texture2D VisionFieldTexture;
SamplerState VisionFieldSampler;

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;

// 从未被探索过的区域亮度（0 = 全黑，1 = 不压暗）
float SceneFogNotVisibleRegionBrightness;

// 已探索、但当前不可见区域的亮度：经典的"灰雾"。
float SceneFogExploredRegionBrightness;

// 雾层自身的不透明度：0 = 完全透明（画面就是原始场景色，看不出有雾），1 = 完全不透明（完全按亮度压暗）。
// 它与上面两个亮度是正交的两件事：亮度决定"被遮住的地方压多暗"，本参数决定"这层遮蔽本身有多浓"。
float SceneFogOpacity;

/**
 * NDC(x, y) 处的视线与 Z = FogPlaneZ 平面的交点世界 XY。
 *
 * 用两个不同的裁剪 z 反投影出两个有限远的世界点再作差，而不是"相机位置 + 近平面点"：
 *  ① 不依赖远平面有限远（UE 的透视投影远平面在无穷远，z = 0 处的反投影 w 分量为 0，除法会炸）；
 *  ② 不区分透视/正交 —— 正交相机的 ViewLocation 并不是像素射线的起点，用两点差天然绕开这个坑。
 */
float2 ClipToFogPlaneXY(float2 NDC)
{
	const float4 NearWorld4 = mul(float4(NDC, 1.0, 1.0), InvViewProjection);
	const float4 FarWorld4 = mul(float4(NDC, 0.5, 1.0), InvViewProjection);
	const float3 NearWorld = NearWorld4.xyz / NearWorld4.w;
	const float3 FarWorld = FarWorld4.xyz / FarWorld4.w;

	const float3 RayDir = FarWorld - NearWorld;

	// 视线与地面近乎平行时 RayDir.z → 0，交点跑到无穷远：此时该像素在地面上没有有限的对应点，
	// 直接给一个必然落在场外的坐标（覆盖率与已探索都为 0，按"从未探索"处理）。
	if (abs(RayDir.z) < 1e-3 * length(RayDir))
	{
		return float2(-1e9, -1e9);
	}

	const float T = (FogPlaneZ - NearWorld.z) / RayDir.z;
	return NearWorld.xy + T * RayDir.xy;
}

/**
 * 像素**真实所在**的世界 XY：用场景深度把该像素反投影回世界空间。
 *
 * 为什么必须用深度而不是平面求交：视野场是纯 XY 的世界场，圆盘是水平圆（覆盖所有 Z），
 * 所以一个像素只要知道自己的真实 XY 就能严格采样 —— 与相机角度、与像素高度都无关。
 * 而 ClipToFogPlaneXY 假设"像素表面就躺在 FogPlaneZ 平面上"，这是个近似：
 * 表面高出该平面 h 时对应关系会偏掉约 h / tan(俯仰角)，俯角越小偏得越多；
 * 地形起伏处各像素的 h 还各不相同，症状就是雾边被拉伸、且随相机转动相对场景滑移。
 *
 * ⚠ 深度必须按**视口 UV**（InViewportUV）采样，不能用场景色 UV：场景色纹理会自带一份
 * UVScaleBias（本工程实测 0.708 —— 视口内容只占它的一角），而场景深度覆盖整个渲染分辨率，
 * 与视口 UV 一一对应。拿场景色 UV 去采深度，采到的是"另一个屏幕位置"的深度：值仍然有效
 * （不是 0），所以反投影看起来在正常工作，但世界位置整体偏移 —— 表现为雾随相机推拉而错位。
 *
 * 两个退化情形退回平面投影（那里没有有限的对应点，且必然落在场外 → 按"未探索"处理）：
 *  ① reverse-Z 下 device z 为 0（天空 / 无几何）；
 *  ② 反投影得到的 w 为 0。
 */
float2 PixelWorldXYFromDepth(float2 NDC, float2 InViewportUV)
{
#if SHADING_PATH_MOBILE
	// 移动端深度不在 SceneTexturesStruct 里（走 MobileSceneTextures），这里不接：退回平面投影。
	return ClipToFogPlaneXY(NDC);
#else
	// 按**深度纹理自己的尺寸**把视口 UV 换算成纹素坐标：两者分辨率常常不同（TAAU/TSR 场景下
	// 场景色与深度不是一个分辨率），所以只能用它自己的尺寸，不能借用场景色的。
	uint DepthWidth = 0;
	uint DepthHeight = 0;
	SceneTexturesStruct.SceneDepthTexture.GetDimensions(DepthWidth, DepthHeight);
	const int2 DepthPixel = int2(InViewportUV * float2(DepthWidth, DepthHeight));
	const float DeviceZ = SceneTexturesStruct.SceneDepthTexture.Load(int3(DepthPixel, 0)).r;

	if (DeviceZ <= 0.0f)
	{
		return ClipToFogPlaneXY(NDC);
	}

	const float4 World4 = mul(float4(NDC, DeviceZ, 1.0), InvViewProjection);
	if (abs(World4.w) < 1e-6)
	{
		return ClipToFogPlaneXY(NDC);
	}
	return World4.xy / World4.w;
#endif
}

struct FCompositeVSToPS
{
	float4 Position : SV_Position;
	float2 SceneColorUV : TEXCOORD0;

	// [0,1] 视口 UV（三角形角上为 [0,2]）。它与屏幕像素成线性关系，因此是顶点阶段唯一可以
	// 安全交给光栅器插值的量；世界 XY 必须由它在像素阶段逐像素反投影得到。
	float2 ViewportUV : TEXCOORD1;
};

FCompositeVSToPS CompositeVS(uint VertexID : SV_VertexID)
{
	// 一个覆盖整个视口的三角形：(0,0) (2,0) (0,2)。比全屏四边形少一条对角线，
	// 也没有两个三角形接缝处的重复光栅化。
	const float2 Corner = float2(float((VertexID << 1u) & 2u), float(VertexID & 2u));

	FCompositeVSToPS Output;
	Output.Position = float4(Corner.x * 2.0 - 1.0, 1.0 - Corner.y * 2.0, 0.0, 1.0);
	Output.SceneColorUV = Corner * SceneColorUVScaleBias.xy + SceneColorUVScaleBias.zw;
	Output.ViewportUV = Corner;
	return Output;
}

float4 CompositePS(FCompositeVSToPS Input) : SV_Target0
{
	// 采样场景色用双线性：场景色纹理可能比视口大（分屏时视图只占一块），UV 已经做过换算。
	const float4 SceneColor = SceneColorTexture.SampleLevel(SceneColorSampler, Input.SceneColorUV, 0);

	// 视口 UV → NDC（Y 翻转：视口 UV 向下增长，NDC 向上），再逐像素反投影到该像素真实世界位置。
	// 注意是"真实位置"而不是"投到 FogPlaneZ 平面"：后者在斜视与地形起伏下会让雾相对场景滑移。
	const float2 NDC = float2(Input.ViewportUV.x * 2.0 - 1.0, 1.0 - Input.ViewportUV.y * 2.0);
	const float2 FieldUV = (PixelWorldXYFromDepth(NDC, Input.ViewportUV) - FieldWorldMin) / FieldWorldExtent;

	// 场外（相机看向地图范围之外）：那里的世界位置既不可能落在任何视野圆内，也从未被探索过。
	// 不能只靠 clamp 采样兜底 —— clamp 会把地图边缘那一列纹素一路拉伸到屏幕外，让地图外也亮起来。
	float Coverage = 0.0;
	float Explored = 0.0;
	if (all(FieldUV >= 0.0) && all(FieldUV <= 1.0))
	{
		// 双线性采样同时服务于两件事：场纹素比屏幕像素粗时把边界软化到亚像素，
		// 以及把探索层的格边界（0/255 二值）软化成一层灰雾过渡带。
		const float2 Field = VisionFieldTexture.SampleLevel(VisionFieldSampler, FieldUV, 0).rg;
		Coverage = saturate(Field.r);
		Explored = saturate(Field.g);
	}

	// 三态合成：从未探索 → 压到 NotVisibleRegionBrightness；探索过但当前不可见 → 抬到
	// ExploredRegionBrightness；当前可见 → 原色。两次 lerp 的先后无关紧要（两个量互相独立），
	// 取 Coverage 在后是为了让"当前可见"永远赢过"已探索"。
	float Brightness = SceneFogNotVisibleRegionBrightness;
	Brightness = lerp(Brightness, SceneFogExploredRegionBrightness, Explored);
	Brightness = lerp(Brightness, 1.0, Coverage);

	const float3 FoggedColor = SceneColor.rgb * Brightness;

	// 浓度：不透明度为 0 时这一层完全透出场景色，为 1 时才是上面那套完整的三态遮蔽。
	// 当前可见的像素 Brightness 恒为 1（FoggedColor == SceneColor），因此这里只改变被遮蔽的像素。
	return float4(lerp(SceneColor.rgb, FoggedColor, SceneFogOpacity), SceneColor.a);
}
